<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".Acciones">

    <TextView
        android:id="@+id/tvusuacciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/encabezado"
        android:paddingTop="28dp"
        android:paddingBottom="28dp"
        android:gravity="center"
        android:text="Nombre Usuario"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvtitacc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:text="Ver Acciones"
        android:textColor="@color/texto"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvvacio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aún no hay acciones registradas"
        android:textColor="@color/texto_suave"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvacciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/tarjeta"
        android:padding="4dp"
        android:divider="@color/borde"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnvolacc"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/volver"
        android:text="Volver"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:cornerRadius="28dp" />

</LinearLayout>
