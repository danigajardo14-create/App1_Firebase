<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".Principal">

    <ImageView
        android:id="@+id/ivlogin"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="40dp"
        android:contentDescription="Logo del Usuario"
        android:src="@drawable/ic_usuario" />

    <TextView
        android:id="@+id/tvlogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Login"
        android:textColor="@color/primario_oscuro"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvsublogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Control y monitoreo IoT"
        android:textColor="@color/texto_suave"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/txtrut"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/borde_campo"
        android:gravity="center"
        android:hint="Rut (ej: 11.111.111-1)"
        android:autofillHints="username"
        android:importantForAutofill="no"
        android:inputType="text"
        android:textColor="@color/texto"
        android:textColorHint="@color/texto_suave"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/txtcon"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/borde_campo"
        android:gravity="center"
        android:hint="Contraseña"
        android:autofillHints="password"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:textColor="@color/texto"
        android:textColorHint="@color/texto_suave"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnini"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/primario"
        android:text="Iniciar Sesión"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:cornerRadius="28dp" />

    <Button
        android:id="@+id/btncrear"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/primario"
        android:text="Crear Cuenta"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:cornerRadius="28dp" />

</LinearLayout>
