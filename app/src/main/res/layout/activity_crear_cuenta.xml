<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    tools:context=".CrearCuenta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

    <TextView
        android:id="@+id/tvtitcre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="Crear Cuenta"
        android:textColor="@color/texto"
        android:textSize="26sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/txtrutcre"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/borde_campo"
        android:gravity="center"
        android:hint="Rut (ej: 11.111.111-1)"
        android:autofillHints="username"
        android:importantForAutofill="no"
        android:inputType="text"
        android:textColor="@color/texto"
        android:textColorHint="@color/texto_suave"
        android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:orientation="horizontal">

    <EditText
        android:id="@+id/txtnomcre"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/borde_campo"
        android:gravity="center"
        android:hint="Nombre"
        android:autofillHints="username"
        android:importantForAutofill="no"
        android:inputType="textPersonName|textCapWords"
        android:textColor="@color/texto"
        android:textColorHint="@color/texto_suave"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/txtapecre"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/borde_campo"
        android:gravity="center"
        android:hint="Apellido"
        android:autofillHints="username"
        android:importantForAutofill="no"
        android:inputType="textPersonName|textCapWords"
        android:textColor="@color/texto"
        android:textColorHint="@color/texto_suave"
        android:textSize="18sp" />

        </LinearLayout>

    <EditText
        android:id="@+id/txtcorcre"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/borde_campo"
        android:gravity="center"
        android:hint="Correo Electrónico"
        android:autofillHints="username"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        android:textColor="@color/texto"
        android:textColorHint="@color/texto_suave"
        android:textSize="18sp" />

    <Spinner
        android:id="@+id/spcargo"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:entries="@array/cargos"
        android:spinnerMode="dropdown" />

    <EditText
        android:id="@+id/txtconcre"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/borde_campo"
        android:gravity="center"
        android:hint="Contraseña"
        android:autofillHints="password"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:textColor="@color/texto"
        android:textColorHint="@color/texto_suave"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/txtrepcre"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/borde_campo"
        android:gravity="center"
        android:hint="Repetir Contraseña"
        android:autofillHints="password"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:textColor="@color/texto"
        android:textColorHint="@color/texto_suave"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

    <Button
        android:id="@+id/btnreg"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="56dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/primario"
        android:text="Registrar"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:cornerRadius="28dp" />

    <Button
        android:id="@+id/btnvolcre"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="56dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/volver"
        android:text="Volver"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:cornerRadius="28dp" />

    </LinearLayout>

    </LinearLayout>
</ScrollView>
