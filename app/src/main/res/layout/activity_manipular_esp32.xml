<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".ManipularESP32">

    <TextView
        android:id="@+id/tvusumanipular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/encabezado"
        android:paddingTop="28dp"
        android:paddingBottom="28dp"
        android:gravity="center"
        android:text="Nombre Usuario"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvtitman"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:text="Manipular Circuito"
        android:textColor="@color/texto"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvestado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado: -"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvconexion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="● Conectando..."
        android:textColor="@color/texto_suave"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/tarjeta"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <View
            android:id="@+id/ledverde"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/led"
            android:backgroundTint="@color/led_apagado" />

        <View
            android:id="@+id/ledamarillo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/led"
            android:backgroundTint="@color/led_apagado" />

        <View
            android:id="@+id/ledrojo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/led"
            android:backgroundTint="@color/led_apagado" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvzona"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistema apagado"
                android:textColor="@color/texto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvbuzzer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buzzer: apagado"
                android:textColor="@color/texto_suave"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginHorizontal="10dp"
            android:padding="0dp"
            android:background="@drawable/circulo_activar"
            android:text="Activar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnoff"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginHorizontal="10dp"
            android:padding="0dp"
            android:background="@drawable/circulo_desactivar"
            android:text="Desactivar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

    <Button
        android:id="@+id/btnsensor"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="@color/acento"
        android:text="Simular Lectura Sensor"
        android:textAllCaps="false"
        android:textColor="@color/texto"
        android:textSize="18sp"
        app:cornerRadius="28dp" />

    <TextView
        android:id="@+id/tvultimo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Sin acciones registradas"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnvolman"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/volver"
        android:text="Volver"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:cornerRadius="28dp" />

</LinearLayout>
